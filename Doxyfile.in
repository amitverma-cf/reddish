# Generated by CMake. Edit this template, not the build-directory copy.

PROJECT_NAME           = "Reddish"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "A minimal Redis-like in-memory database"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_SOURCE_DIR@/docs"
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/README.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/src" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/client/C++/src"
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */src/database/* */src/protocol/*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
VERBATIM_HEADERS       = NO
SHOW_FILES             = NO
SHOW_DIRECTORIES       = NO
SHOW_NAMESPACES        = NO
SEPARATE_MEMBER_PAGES  = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
HAVE_DOT               = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = "@AWESOME_CSS_DIR@/doxygen-awesome.css" \
                         "@AWESOME_CSS_DIR@/doxygen-awesome-sidebar-only.css" \
                         "@AWESOME_CSS_DIR@/doxygen-awesome-sidebar-only-darkmode-toggle.css" \
                         "@REDDISH_DOC_ASSETS_DIR@/reddish.css"
HTML_EXTRA_FILES       = "@AWESOME_CSS_DIR@/doxygen-awesome-darkmode-toggle.js" \
                         "@AWESOME_CSS_DIR@/doxygen-awesome-fragment-copy-button.js" \
                         "@AWESOME_CSS_DIR@/doxygen-awesome-interactive-toc.js"
HTML_HEADER            = "@REDDISH_DOC_ASSETS_DIR@/header.html"
HTML_FOOTER            = "@REDDISH_DOC_ASSETS_DIR@/footer.html"
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"
SORT_MEMBER_DOCS       = YES
